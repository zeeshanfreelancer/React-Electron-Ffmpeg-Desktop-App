{
  "name": "slideshow-generator",
  "version": "1.0.0",
  "main": "main/main.js",
  "author": "Your Name",
  "description": "Professional slideshow and video generator with AI voice synthesis",
  "scripts": {
    "start": "concurrently \"npm run dev --prefix client\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build": "npm run build --prefix client && electron-builder"
  },
  "build": {
    "appId": "com.slideshowgenerator.app",
    "productName": "Slideshow Generator",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "compression": "normal",
    "files": [
      "main/**",
      "client/dist/**",
      "package.json",
      "node_modules/**",
      "!dist/**",
      "!dist-*/**",
      "!dist-final/**",
      "!**/xtts/server/**",
      "!**/xtts/bin/**",
      "!**/xtts/models/**",
      "!**/xtts/voices/**",
      "!**/*.log",
      "!node_modules/.cache/**",
      "!node_modules/**/*.{md,ts,map}",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/*.test.js",
      "!node_modules/**/*.spec.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": "xtts",
        "to": "xtts",
        "filter": [
          "bin/**",
          "models/**",
          "voices/**",
          "README.md"
        ]
      }
    ]
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^167.0.0",
    "gtts": "^0.2.1",
    "skia-canvas": "^3.0.8",
    "wait-on": "^9.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  }
}
